{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "noEmit": true,
    // Mirrors the vite `resolve.alias` entries. Without these, `npm run typecheck`
    // fails on every alias import (components/…, lib/…) and checks nothing.
    "paths": {
      "components/*": ["./src/components/*"],
      "features/*": ["./src/features/*"],
      "hooks/*": ["./src/hooks/*"],
      "i18n": ["./src/i18n"],
      "i18n/*": ["./src/i18n/*"],
      "lib/*": ["./src/lib/*"],
      "pages/*": ["./src/pages/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}